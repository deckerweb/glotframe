{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "glotframe/project-list",
  "version": "1.0.0",
  "title": "Project overview",
  "category": "glotframe",
  "icon": "translation",
  "textdomain": "glotframe",
  "attributes": {
    "projectId": {
      "type": "integer",
      "default": 0
    },
    "source": {
      "type": "string",
      "default": "roots",
      "enum": [
        "roots",
        "children"
      ]
    },
    "view": {
      "type": "string",
      "default": "list",
      "enum": [
        "list",
        "grid"
      ]
    },
    "sort": {
      "type": "string",
      "default": "asc",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "activeOnly": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "boolean",
      "default": true
    },
    "locale": {
      "type": "string",
      "default": ""
    },
    "limit": {
      "type": "integer",
      "default": 5
    }
  },
  "supports": {
    "html": false,
    "multiple": true
  },
  "style": "glotframe-data-blocks"
}
